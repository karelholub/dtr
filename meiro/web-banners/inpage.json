  "contentMode": "html",
  "contentHtml": "<!doctype html>\n<html lang=\"de\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0;background:transparent;color:#292321;font-family:Arial,sans-serif}\n.card{display:grid;grid-template-columns:64px minmax(0,1fr) auto;align-items:center;gap:24px;padding:28px 32px;background:#fff;border:1px solid #e8ded7;border-left:5px solid #d71920;border-radius:10px}\n.symbol{display:grid;place-items:center;width:64px;height:64px;border-radius:50%;background:#fff3e9;color:#d71920}\n.eyebrow{margin:0 0 8px;color:#b51620;font-size:11px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase}\nh2{margin:0 0 8px;font-size:24px;line-height:1.2;letter-spacing:-.4px}\np{margin:0;font-size:15px;line-height:1.5;color:#655b56}\n.cta{display:inline-flex;align-items:center;justify-content:center;gap:16px;padding:13px 18px;border:1px solid #d71920;border-radius:5px;color:#bd1720;background:#fff;text-decoration:none;font-size:14px;line-height:1.3;font-weight:700;white-space:nowrap}\n.cta:hover{background:#fff3ef}.cta:focus-visible{outline:3px solid #292321;outline-offset:4px}\n.note{margin-top:8px;text-align:center;font-size:11px;color:#796e67}\n@media(max-width:760px){.card{grid-template-columns:48px minmax(0,1fr);gap:16px;padding:24px}.symbol{width:48px;height:48px}.symbol svg{width:30px;height:30px}.action{grid-column:2}h2{font-size:22px}.note{text-align:left}}\n@media(max-width:420px){.card{gap:12px;padding:20px 16px;grid-template-columns:36px minmax(0,1fr)}.symbol{width:36px;height:36px}.symbol svg{width:24px;height:24px}.eyebrow{font-size:10px;letter-spacing:1px}h2{font-size:20px}.cta{white-space:normal;text-align:left;padding:12px 14px}p{font-size:14px}}\n</style>\n</head>\n<body>\n<article class=\"card\" aria-label=\"Urlaubsidee Mallorca\">\n<div class=\"symbol\" aria-hidden=\"true\"><svg width=\"38\" height=\"38\" viewBox=\"0 0 40 40\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"20\" cy=\"20\" r=\"8\"/><path d=\"M20 3v4m0 26v4M3 20h4m26 0h4M8 8l3 3m18 18 3 3M8 32l3-3M29 11l3-3\"/></svg></div>\n<div><p class=\"eyebrow\">DERTOUR · Urlaubsidee</p><h2>Mallorca für die ganze Familie</h2><p>Gemeinsam Sonne tanken, Neues entdecken und Zeit füreinander finden.</p></div>\n<div class=\"action\"><a class=\"cta\" href=\"/hotel/calimera-fido-gardens\" target=\"_top\">Familienurlaub entdecken <span aria-hidden=\"true\">→</span></a><p class=\"note\">Inspiration · Demo-Angebot</p></div>\n</article>\n</body>\n</html>\n",
  "size": {
    "preset": "full_width"
  },
  "placement": {
    "type": "inline",
    "anchorType": "id",
    "anchorValue": "dtr-meiro-inpage"
  },
  "conditions": {
    "mode": "all",
    "rules": [
      {
        "mode": "any",
        "rules": [
          {
            "field": "host",
            "operator": "equals",
            "value": "dtrdemo.netlify.app"
          },
          {
            "field": "host",
            "operator": "equals",
            "value": "127.0.0.1"
          },
          {
            "field": "host",
            "operator": "equals",
            "value": "localhost"
          }
        ]
      },
      {
        "field": "path",
        "operator": "equals",
        "value": "/"
      }
    ]
  },
  "frequencyCap": {
    "limit": 5,
    "period": "session"
  },
  "displayTrigger": {
    "type": "page_load"
  }
}
